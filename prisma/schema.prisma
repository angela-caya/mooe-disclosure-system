generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum Role {
  PRINCIPAL
  DISBURSING_OFFICER
}

enum ReportStatus {
  DRAFT
  PENDING
  APPROVED
}

enum ExpenseCategory {
  UTILITIES
  SUPPLIES
  MINOR_REPAIRS
  TRAVEL
  TRAINING
  OTHERS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SUBMIT
  APPROVE
  REJECT
}

enum AIPPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

// --- MODELS ---

// System users (e.g., Principal, Disbursing Officer)
model User {
  id           String  @id @default(cuid())
  name         String?
  email        String? @unique
  password     String? // Hashed password
  role         Role    @default(DISBURSING_OFFICER)
  signatureUrl String? // Path to the Principal's e-signature for reports

  // Relationship: Reports created by a Disbursing Officer
  reportsCreated  LiquidationReport[] @relation("CreatedBy")
  // Relationship: Reports approved by a Principal
  reportsApproved LiquidationReport[] @relation("ApprovedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
}

// Table for dynamic signatories (Appendix 44 selections)
model Signatory {
  id        String   @id @default(cuid())
  name      String
  position  String   // Expected values: "PRINCIPAL", "ASDS", "SDS", "ACCOUNTANT"
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIPSetting {
  id               String @id @default(cuid())
  year             Int    @unique
  // Target percentages (e.g., 0.30 for 30%)
  utilitiesPercent Float  @default(0)
  suppliesPercent  Float  @default(0)
  repairsPercent   Float  @default(0)
  travelPercent    Float  @default(0)
  trainingPercent  Float  @default(0)
  othersPercent    Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MonthlyAllocation {
  id          String @id @default(cuid())
  month       Int // 1 to 12
  year        Int
  totalAmount Float // The actual cash allocation received for this month

  // Link to the monthly report
  reports LiquidationReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
}

// Records of specific expenditures for liquidation
model LiquidationReport {
  id                String       @id @default(cuid())
  month             Int
  year              Int
  status            ReportStatus @default(DRAFT)
  remarks           String?

  // Appendix 44 Fields & Signatory Snapshots (Name & Position)
  yearlySequence    Int       @default(1)
  fundPurpose       String    @default("MOOE")
  birDeduction      Float     @default(0)
  dvNumber          String?
  dvDate            DateTime?

  principalName     String?
  principalPosition String?   // Box A Position (e.g. Principal II)
  asdsName          String?
  asdsPosition      String?   // Box B Position (e.g. ASDS / OIC)
  sdsName           String?
  sdsPosition       String?   // Box B Position (e.g. Schools Division Superintendent)
  accountantName    String?
  accountantPosition String?  // Box C Position (e.g. Head, Accounting Division Unit)
  
  entityName        String    @default("BINAN CITY SENIOR HIGH SCHOOL-WEST CAMPUS")
  fundCluster       String    @default("01")
  centerCode        String    @default("070010804019")
  // -----------------------------------

  // Ownership and Approval
  disbursingOfficerId String
  disbursingOfficer   User   @relation("CreatedBy", fields: [disbursingOfficerId], references: [id])

  principalId String? // Populated upon approval
  principal   User?   @relation("ApprovedBy", fields: [principalId], references: [id])

  // Context: Total amount this report is drawing from
  allocationId String
  allocation   MonthlyAllocation @relation(fields: [allocationId], references: [id])

  // Itemized data
  expenses Expense[]

  submittedAt DateTime? // When status changed from DRAFT to PENDING
  approvedAt  DateTime? // When status changed to APPROVED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([month, year]) // Ensures only one report exists per month
}

// Represents individual expenditures drawn from the budget
model Expense {
  id          String          @id @default(cuid())
  description String // Itemized name/description
  amount      Float
  date        DateTime
  category    ExpenseCategory

  // Link back to the parent report
  reportId String
  report   LiquidationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Immutable ledger for tracking all system activities
model AuditLog {
  id       String      @id @default(cuid())
  action   AuditAction
  entity   String // Represents the table name (e.g., LiquidationReport, Expense)
  entityId String // The unique identifier of the modified record
  details  String // Human-readable context of the transaction

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model AIPPlan {
  id     String        @id @default(cuid())
  year   Int           @unique
  status AIPPlanStatus @default(DRAFT)

  submittedAt       DateTime?
  approvedAt        DateTime?
  externalReference String?

  budgetLines AIPBudgetLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, year])
}

model AIPBudgetLine {
  id            String          @id @default(cuid())
  description   String
  category      ExpenseCategory
  plannedAmount Decimal         @db.Decimal(15, 2)
  remarks       String?

  aipPlanId String
  aipPlan   AIPPlan @relation(fields: [aipPlanId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aipPlanId])
  @@index([category])
}
