generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum Role {
  SYSTEM_ADMIN
  PRINCIPAL
  DISBURSING_OFFICER
}

enum ReportStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseCategory {
  UTILITIES
  SUPPLIES
  MINOR_REPAIRS
  TRAVEL
  TRAINING
  OTHERS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SUBMIT
  APPROVE
  REJECT
  LOGIN
  LOGOUT
}

enum AIPPlanStatus {
  DRAFT
  PENDING
  APPROVED
}

enum AdjustmentType {
  REALLOCATION       // Reallocates funds between categories
  ADDITIONAL_FUND    // Requests supplemental budget from the Division Office
  RETURN_TO_DIVISION // Returns excess balance to the Division Office
}

// --- MODELS ---

// Core system users and role definitions
model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  password            String?
  role                Role                 @default(DISBURSING_OFFICER)
  signatureUrl        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  
  liquidationReports LiquidationReport[]   @relation("ReportDisbursingOfficer")
  createdReports     LiquidationReport[]   @relation("ReportCreator")
  adjustmentRequests  BudgetAdjustment[]   @relation("AdjustmentRequests")
  adjustmentApprovals BudgetAdjustment[]   @relation("AdjustmentApprovals")
  auditLogs           AuditLog[]
}

// Dynamic signatory profiles for Appendix 44 rendering
model Signatory {
  id        String   @id @default(cuid())
  name      String
  position  String
  box       String   @default("A")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Global percentage thresholds for Annual Improvement Plan (AIP) categories
model AIPSetting {
  id               String   @id @default(cuid())
  year             Int      @unique
  utilitiesPercent Float
  suppliesPercent  Float
  repairsPercent   Float
  travelPercent    Float
  trainingPercent  Float
  othersPercent    Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Annual Improvement Plan (AIP) parent record
model AIPPlan {
  id                String          @id @default(cuid())
  year              Int             @unique
  status            AIPPlanStatus   @default(DRAFT)
  submittedAt       DateTime?
  approvedAt        DateTime?
  externalReference String?
  budgetLines       AIPBudgetLine[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// Category-specific budget allocations under an annual AIP plan
model AIPBudgetLine {
  id                 String              @id @default(cuid())
  aipPlanId          String
  aipPlan            AIPPlan             @relation(fields: [aipPlanId], references: [id], onDelete: Cascade)
  category           ExpenseCategory
  description        String
  plannedAmount      Decimal
  remarks            String?
  
  monthlyBudgetLines MonthlyBudgetLine[]
  
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// Monthly baseline distribution derived from the annual AIP budget
model MonthlyBudgetLine {
  id                String             @id @default(cuid())
  aipBudgetLineId   String
  aipBudgetLine     AIPBudgetLine      @relation(fields: [aipBudgetLineId], references: [id], onDelete: Cascade)
  month             Int
  year              Int
  plannedAmount     Decimal
  
  adjustmentsAsSrc  BudgetAdjustment[] @relation("AdjustmentSource")
  adjustmentsAsDst  BudgetAdjustment[] @relation("AdjustmentDestination")
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([aipBudgetLineId, month, year])
}

// Tracks budget reallocations, supplemental funds, and returned excesses
model BudgetAdjustment {
  id                 String             @id @default(cuid())
  adjustmentType     AdjustmentType     @default(REALLOCATION)
  
  sourceLineId       String?            // Funding source
  sourceLine         MonthlyBudgetLine? @relation("AdjustmentSource", fields: [sourceLineId], references: [id])
  
  destinationLineId  String?            // Funding destination
  destinationLine    MonthlyBudgetLine? @relation("AdjustmentDestination", fields: [destinationLineId], references: [id])
  
  amount             Decimal
  reason             String
  referenceDoc       String?            // E.g., OR Number or Division Memo
  
  requestedById      String
  requestedBy        User               @relation("AdjustmentRequests", fields: [requestedById], references: [id])
  
  approvedById       String?
  approvedBy         User?              @relation("AdjustmentApprovals", fields: [approvedById], references: [id])
  
  status             ReportStatus       @default(PENDING)
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// Aggregated monthly cash allocation for the school
model MonthlyAllocation {
  id          String              @id @default(cuid())
  month       Int
  year        Int
  totalAmount Float
  reports     LiquidationReport[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([month, year])
}

// Main Liquidation Report (Appendix 44) containing metadata and signatory snapshots
model LiquidationReport {
  id                  String            @id @default(cuid())
  month               Int
  year                Int
  status              ReportStatus      @default(DRAFT)
  remarks             String?
  submittedAt         DateTime?
  approvedAt          DateTime?
  
  yearlySequence      Int               @default(1)
  fundPurpose         String            @default("MOOE")
  birDeduction        Float             @default(0)
  dvNumber            String?
  dvDate              DateTime?
  
  principalName       String?
  principalPosition   String?
  asdsName            String?
  asdsPosition        String?
  sdsName             String?
  sdsPosition         String?
  accountantName      String?
  accountantPosition  String?
  
  entityName          String            @default("BINAN CITY SENIOR HIGH SCHOOL-WEST CAMPUS")
  fundCluster         String            @default("01")
  centerCode          String            @default("070010804019")
  
  allocationId        String
  allocation          MonthlyAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  
  disbursingOfficerId String?
  disbursingOfficer   User?   @relation("ReportDisbursingOfficer", fields: [disbursingOfficerId], references: [id])

  createdById String?
  createdBy   User?   @relation("ReportCreator", fields: [createdById], references: [id])
  
  expenses            Expense[]
  
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([month, year])
}

// Individual receipt/expense entries tied to a Liquidation Report
model Expense {
  id          String            @id @default(cuid())
  reportId    String
  report      LiquidationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  description String
  amount      Float
  taxAmount   Float             @default(0)
  date        DateTime
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// Immutable ledger for tracking system activity
model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  entity    String
  entityId  String?
  details   String
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())
}